{
  "$schema": "../schemas/settings.schema.json",
  "sources": {
    "engine": {
      "tag": "stable"
    },
    "engine-res": {
      "tag": "stable"
    },
    "official-res": {
      "tag": "stable"
    }
  },
  "build": {
    "generate_fs_path": true,
    "output_dir": "../dist",
    "asset_dirs": [
      "../assets",
      "../scripts"
    ],
    "asset_ignores": [
      "assets/image/PlayerAnim/**",
      "assets/image/FishAnim/**",
      "../assets/image/PlayerAnim/**",
      "../assets/image/FishAnim/**",
      "image/PlayerAnim/**",
      "image/FishAnim/**",
      "assets/image/子弹动画/**",
      "../assets/image/子弹动画/**",
      "image/子弹动画/**",
      "assets/audio/Music/**",
      "assets/audio/SoundsEffects/**",
      "../assets/audio/Music/**",
      "../assets/audio/SoundsEffects/**",
      "audio/Music/**",
      "audio/SoundsEffects/**"
    ]
  },
  "@runtime": {
    "multiplayer": {
      "enabled": false,
      "max_players": 4,
      "background_match": false,
      "match_info": {
        "desc_name": "free_match",
        "immediately_start": false,
        "match_timeout": 0,
        "player_number": 1
      },
      "persistent_world": {
        "enabled": false
      }
    }
  }
}